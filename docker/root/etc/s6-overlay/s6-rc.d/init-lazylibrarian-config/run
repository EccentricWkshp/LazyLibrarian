#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Prepare /config before LazyLibrarian starts, the same way as the linuxserver.io image

mkdir -p \
    /config \
    /books \
    /downloads

# a new install starts with the library and download folders the example compose file mounts
if [[ ! -e /config/config.ini ]]; then
    cp /defaults/config.ini /config/config.ini
fi

lsiown -R abc:abc \
    /config

lsiown abc:abc \
    /books \
    /downloads
